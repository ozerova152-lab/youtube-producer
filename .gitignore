# Секреты и локальные ключи
.env
.env.*
!.env.example

# Данные каналов пользователя (стратегии, брифы, кэш API)
data/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Артефакты UI-тестов (скриншоты, трейсы): пересоздаются прогоном
test-results/

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
.idea/
.vscode/

# Артефакты проверок: скриншоты и бинарники локальные
*.png
*.jpg

# артефакты задач: в git идут только текстовые доказательства (логи, выписки, json);
# скриншоты и прочие бинарники — локальные, в коммиты не попадают
docs/tasks/artifacts/**
!docs/tasks/artifacts/**/
!docs/tasks/artifacts/**/*.txt
!docs/tasks/artifacts/**/*.md
!docs/tasks/artifacts/**/*.log
!docs/tasks/artifacts/**/*.json
!docs/tasks/artifacts/**/*.csv
!docs/tasks/artifacts/**/*.sql
